\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Fingerprint-component ablation on the VIVOS phrase-level pool ($n_{\textrm  {intra}}=n_{\textrm  {inter}}=50$). Bars show the discrimination gap (intra cos $-$ inter cos) for each ablation variant; the full 272-d fingerprint reaches gap $=0.148$. Removing the MFCC trajectory collapses the gap to nearly zero; removing the tone histogram leaves the phrase-level gap unchanged because the cosine is saturated by the 260-d segmental signal, motivating the two-stream voting of \S  \ref {sec:method:twostream}.}}{11}{figure.4}\protected@file@percent }
\newlabel{fig:fingerprint_ablation}{{4}{11}{Fingerprint-component ablation on the VIVOS phrase-level pool ($n_{\textrm {intra}}=n_{\textrm {inter}}=50$). Bars show the discrimination gap (intra cos $-$ inter cos) for each ablation variant; the full 272-d fingerprint reaches gap $=0.148$. Removing the MFCC trajectory collapses the gap to nearly zero; removing the tone histogram leaves the phrase-level gap unchanged because the cosine is saturated by the 260-d segmental signal, motivating the two-stream voting of \S \ref {sec:method:twostream}}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Tonal minimal-pair protection (intra-tone cos $-$ inter-syllable cos) across fingerprint variants on the 25 synthesized Vietnamese minimal pairs. The 6-d tone-only fingerprint is the only variant with positive protect score ($+0.028$); the full 272-d concatenation and the MFCC-only variant both fail in the wrong direction.}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:minimal_pair_ablation}{{5}{11}{Tonal minimal-pair protection (intra-tone cos $-$ inter-syllable cos) across fingerprint variants on the 25 synthesized Vietnamese minimal pairs. The 6-d tone-only fingerprint is the only variant with positive protect score ($+0.028$); the full 272-d concatenation and the MFCC-only variant both fail in the wrong direction}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Two-stream voting evaluation on $5\times 6 = 30$ synthesized minimal-pair clips. With $(\tau _A,\tau _B)=(0.85,0.93)$ both streams agree on $30/30$ self-lookups and $0/25$ tonal variants. The diagnostic counter exposes the vetoes: 5 segment-only hits and 3 tone-only hits, all neutralized by the AND-gate.}}{11}{figure.6}\protected@file@percent }
\newlabel{fig:twostream_voting}{{6}{11}{Two-stream voting evaluation on $5\times 6 = 30$ synthesized minimal-pair clips. With $(\tau _A,\tau _B)=(0.85,0.93)$ both streams agree on $30/30$ self-lookups and $0/25$ tonal variants. The diagnostic counter exposes the vetoes: 5 segment-only hits and 3 tone-only hits, all neutralized by the AND-gate}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Per-stage latency stack on the $n=10$ paired VIVOS bench. FP32 cascade vs.\ INT8 cascade. MT receives the largest INT8 speedup ($6.23\times $, $p=0.002$), ASR receives $2.00\times $ ($p=0.002$), TTS is not significant ($1.26\times $, $p=0.181$).}}{11}{figure.7}\protected@file@percent }
\newlabel{fig:latency_stack}{{7}{11}{Per-stage latency stack on the $n=10$ paired VIVOS bench. FP32 cascade vs.\ INT8 cascade. MT receives the largest INT8 speedup ($6.23\times $, $p=0.002$), ASR receives $2.00\times $ ($p=0.002$), TTS is not significant ($1.26\times $, $p=0.181$)}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Cumulative speedup from each augmentation over the INT8 cascade ($n=3$ paired). Tone-VAD $1.20\times $, T1 alone $1.37\times $, T2 alone $1.34\times $, T1+T2 jointly $1.80\times $. Bound $p_{\min }\approx 0.25$ reflects the $2^{3}=8$ permutation ceiling at $n=3$.}}{11}{figure.8}\protected@file@percent }
\newlabel{fig:ablation_speedup}{{8}{11}{Cumulative speedup from each augmentation over the INT8 cascade ($n=3$ paired). Tone-VAD $1.20\times $, T1 alone $1.37\times $, T2 alone $1.34\times $, T1+T2 jointly $1.80\times $. Bound $p_{\min }\approx 0.25$ reflects the $2^{3}=8$ permutation ceiling at $n=3$}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Cooperation between the spectral-subtraction filter and the cache. At SNR $\leq 10$~dB the filter raises mean cosine similarity by $+0.248$ to $+0.712$ ($p<0.001$), lifting cache hit rate at $\tau =0.95$ from $0/10$ to $5/10$ at $10$~dB and from $3/10$ to $9/10$ at $15$~dB.}}{11}{figure.9}\protected@file@percent }
\newlabel{fig:noise_robustness}{{9}{11}{Cooperation between the spectral-subtraction filter and the cache. At SNR $\leq 10$~dB the filter raises mean cosine similarity by $+0.248$ to $+0.712$ ($p<0.001$), lifting cache hit rate at $\tau =0.95$ from $0/10$ to $5/10$ at $10$~dB and from $3/10$ to $9/10$ at $15$~dB}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Fleet-scale Poisson+Zipf simulator. Mean latency reduction vs.\ cascade-only baseline at $N\in \{10,50,200\}$ workers stays in the $78$--$94\%$ band. T1 (per-worker) saturates earliest; load progressively shifts to the shared T2 cache, producing graceful degradation rather than catastrophic miss collapse.}}{12}{figure.10}\protected@file@percent }
\newlabel{fig:worker_scale}{{10}{12}{Fleet-scale Poisson+Zipf simulator. Mean latency reduction vs.\ cascade-only baseline at $N\in \{10,50,200\}$ workers stays in the $78$--$94\%$ band. T1 (per-worker) saturates earliest; load progressively shifts to the shared T2 cache, producing graceful degradation rather than catastrophic miss collapse}{figure.10}{}}
