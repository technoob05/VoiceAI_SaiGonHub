\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces $\tau _{A}$-tightening sweep under the existence rule with $\tau _{B}$ fixed at $0.93$. Left axis: tonal-variant correct-miss rate ($25$ minimal pairs). Right axis: VIVOS positive-pair recall ($200$ pairs, same-text different-speaker). Correct-miss rises by at most $+4$~pp across the entire sweep, while VIVOS recall monotonically degrades from $11\%$ to $8\%$. No grid point clears the pre-registered $\geq 24/25$ safety acceptance criterion; the dashed horizontal line marks the criterion. The sweep recommends \emph  {retaining} $\tau _{A}=0.85$ and treats tonal-precision recovery as a representation-side problem (\S  \ref {sec:limitations}) rather than a threshold-calibration problem.}}{17}{figure.6}\protected@file@percent }
\newlabel{fig:tau_a_tightening}{{6}{17}{$\tau _{A}$-tightening sweep under the existence rule with $\tau _{B}$ fixed at $0.93$. Left axis: tonal-variant correct-miss rate ($25$ minimal pairs). Right axis: VIVOS positive-pair recall ($200$ pairs, same-text different-speaker). Correct-miss rises by at most $+4$~pp across the entire sweep, while VIVOS recall monotonically degrades from $11\%$ to $8\%$. No grid point clears the pre-registered $\geq 24/25$ safety acceptance criterion; the dashed horizontal line marks the criterion. The sweep recommends \emph {retaining} $\tau _{A}=0.85$ and treats tonal-precision recovery as a representation-side problem (\S \ref {sec:limitations}) rather than a threshold-calibration problem}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Correct-miss count (out of $100$ tonal-variant probes) for the heuristic 6-d tone histogram (red) vs.\ the learned $32$-d tone embedding (blue) across clean and two industrial-noise conditions, both gated by the same two-stream existence rule with $\tau _B=0.93$. The heuristic is at its calibrated default $\tau _A=0.85$; the learned operating point is the highest correct-miss at full $120/120$ self-lookup recall on clean. The $+56$~pp clean-condition lift and the noise-robustness improvement are the load-bearing measurements behind the headline of \S  \ref {sec:exp:twostream}.}}{17}{figure.7}\protected@file@percent }
\newlabel{fig:learned_tone_vs_heuristic}{{7}{17}{Correct-miss count (out of $100$ tonal-variant probes) for the heuristic 6-d tone histogram (red) vs.\ the learned $32$-d tone embedding (blue) across clean and two industrial-noise conditions, both gated by the same two-stream existence rule with $\tau _B=0.93$. The heuristic is at its calibrated default $\tau _A=0.85$; the learned operating point is the highest correct-miss at full $120/120$ self-lookup recall on clean. The $+56$~pp clean-condition lift and the noise-robustness improvement are the load-bearing measurements behind the headline of \S \ref {sec:exp:twostream}}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Two-stream cache $F_1$ over the $\tau _A \times \tau _B$ grid on $200$ positive and $200$ negative VIVOS pairs. The central rectangle $\tau _A \in [0.80, 0.90] \times \tau _B \in [0.90, 0.93]$ keeps $F_1$ within $[0.156, 0.345]$ across $9$ cells, indicating robust calibration. Red circle marks the deployment default $(0.85, 0.93)$.}}{17}{figure.8}\protected@file@percent }
\newlabel{fig:threshold_heatmap}{{8}{17}{Two-stream cache $F_1$ over the $\tau _A \times \tau _B$ grid on $200$ positive and $200$ negative VIVOS pairs. The central rectangle $\tau _A \in [0.80, 0.90] \times \tau _B \in [0.90, 0.93]$ keeps $F_1$ within $[0.156, 0.345]$ across $9$ cells, indicating robust calibration. Red circle marks the deployment default $(0.85, 0.93)$}{figure.8}{}}
