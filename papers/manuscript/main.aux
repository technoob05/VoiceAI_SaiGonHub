\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Two-stream voting cache. Independent tone stream ($f_A$, 6-d, $\tau _A=0.85$) and segmental stream ($f_B$, 260-d, $\tau _B=0.93$) each nominate the nearest stored entry. A hit fires only when both streams nominate the \emph  {same} entry above their respective thresholds. On the tonal minimal pair \emph  {ma}/\emph  {m\'a}, stream B may report high similarity yet stream A vetoes the match because the tone contours disagree.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:two_stream_arch}{{3}{7}{Two-stream voting cache. Independent tone stream ($f_A$, 6-d, $\tau _A=0.85$) and segmental stream ($f_B$, 260-d, $\tau _B=0.93$) each nominate the nearest stored entry. A hit fires only when both streams nominate the \emph {same} entry above their respective thresholds. On the tonal minimal pair \emph {ma}/\emph {m\'a}, stream B may report high similarity yet stream A vetoes the match because the tone contours disagree}{figure.3}{}}
