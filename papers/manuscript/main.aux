\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces System pipeline. Tone-VAD filters non-speech; the audio cache (T1, two-stream voting) short-circuits the full cascade on hit; the text cache (T2) short-circuits MT on hit. Green = hit path; orange = miss path. Two-stream voting gates T1 hits on simultaneous tone-stream and segmental-stream agreement (T1 hit: $1{,}441\times $ over FP32 cold cascade; T2 hit: $\sim 3$--$12\times $ depending on stages skipped). Models in INT8 throughout.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{5}{System pipeline. Tone-VAD filters non-speech; the audio cache (T1, two-stream voting) short-circuits the full cascade on hit; the text cache (T2) short-circuits MT on hit. Green = hit path; orange = miss path. Two-stream voting gates T1 hits on simultaneous tone-stream and segmental-stream agreement (T1 hit: $1{,}441\times $ over FP32 cold cascade; T2 hit: $\sim 3$--$12\times $ depending on stages skipped). Models in INT8 throughout}{figure.1}{}}
