# UNTESTED on Linux/ARM.
[Unit]
Description=Probe VoiceAI every 45 s with a real inference

[Timer]
# OnBootSec is long because a cold start is minutes, not seconds (measured
# 250 s on x86; ARM unmeasured). Probing before the models are warm would just
# manufacture false failures and restart loops.
OnBootSec=600
OnUnitActiveSec=45
AccuracySec=5

[Install]
WantedBy=timers.target
