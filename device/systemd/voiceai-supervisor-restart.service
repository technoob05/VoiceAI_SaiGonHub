# voiceai-supervisor-restart.service — triggered by the watchdog's OnFailure.
# Restart + re-warm. The re-warm is not optional: loading is when a model is
# most likely to fail, so pay it now while the room is quiet rather than on the
# judge's first sentence (AIBOX geniex-watchdog.sh made the same argument).
# UNTESTED on Linux/ARM.
[Unit]
Description=Restart and re-warm the VoiceAI supervisor

[Service]
Type=oneshot
WorkingDirectory=/opt/voiceai
ExecStart=/bin/systemctl restart voiceai-supervisor.service
ExecStartPost=/usr/bin/python3 device/healthcheck.py --port 8731 --level full --wait 900
TimeoutStartSec=1200
